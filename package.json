{
  "name": "phicomm-r1-control",
  "private": true,
  "type": "module",
  "description": "Static control pages for the Phicomm R1 speaker",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && python3 upstream/sync.py check && vite build && node scripts/prepare-site.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "python3 scripts/serve.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && node scripts/check-site.mjs",
    "test": "npm run test:unit && npm run build && python3 -m unittest discover -s tests -v",
    "test:unit": "node --experimental-strip-types --test tests/web/*.test.mjs",
    "upstream:build": "python3 upstream/sync.py build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material-symbols/svg-400": "^0.48.3",
    "@material/material-color-utilities": "^0.3.0",
    "@material/web": "^2.5.0",
    "vue": "^3.5.45"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "endOfLine": "lf",
    "overrides": [
      {
        "files": "*.webmanifest",
        "options": {
          "parser": "json"
        }
      },
      {
        "files": "*.svg",
        "options": {
          "parser": "html"
        }
      }
    ]
  }
}
